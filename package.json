{
  "name": "@belentani7/skills-registry",
  "version": "1.0.0",
  "description": "Offline-first local CLI skill installer and catalog for AI agents",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "skills": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "validate": "npm run typecheck && npm test",
    "test": "npm run build && node --test tests/cli.test.mjs"
  },
  "keywords": [
    "skills",
    "registry",
    "qwen-code",
    "claude-code",
    "cli-tools"
  ],
  "author": "Belentani",
  "license": "MIT",
  "dependencies": {
    "commander": "^12.0.0",
    "ora": "^8.0.0",
    "semver": "^7.6.0",
    "zod": "^4.0.0",
    "glob": "^11.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0",
    "tsx": "^4.19.0",
    "vitest": "^5.0.4"
  }
}
